```css
/* =========================================================
   MERIDIAN HAUS
   MASTER STYLESHEET
   Powered by The Rogue Chef
   ========================================================= */


/* =========================================================
   1. ROOT VARIABLES
   ========================================================= */

:root {
    --black: #0b0b0b;
    --black-soft: #111111;
    --black-light: #181818;

    --cream: #f5f0e7;
    --cream-dark: #e7dfd2;

    --gold: #c9a45c;
    --gold-light: #dfc47f;

    --white: #ffffff;
    --grey: #aaa59d;
    --grey-dark: #77736d;

    --border: rgba(255, 255, 255, 0.10);

    --max-width: 1200px;
    --transition: 0.3s ease;
}


/* =========================================================
   2. RESET
   ========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--black);
    color: var(--cream);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
    overflow-x: hidden;
}

img {
    display: block;
    width: 100%;
    height: auto;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

ul,
ol {
    padding-left: 1.4rem;
}


/* =========================================================
   3. GLOBAL CONTAINER
   ========================================================= */

.container {
    width: min(92%, var(--max-width));
    margin: 0 auto;
}


/* =========================================================
   4. TYPOGRAPHY
   ========================================================= */

h1,
h2,
h3,
h4 {
    font-family: Georgia, "Times Ne
```

